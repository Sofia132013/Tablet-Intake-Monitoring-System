generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  login    String @id
  password String
  pills    Pill[]
}

model Pill {
  id        Int     @id @default(autoincrement())
  name      String
  time      String
  dosage    String?
  taken     Boolean @default(false)
  date      String
  userLogin String
  user      User    @relation(fields: [userLogin], references: [login], onDelete: Cascade)
}
